# ==============================================================================
# HOWARDS 4 HOPE - ENVIRONMENT & SECRETS CONFIGURATION
# Copy this file to .env and fill in production API keys & credentials
# ==============================================================================

# --- STRIPE PAYMENTS & SUBSCRIPTIONS ---
STRIPE_API_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# --- PAYPAL GATEWAY & RECURRING PLANS ---
PAYPAL_CLIENT_ID=your_paypal_client_id_from_developer_dashboard
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=live

# --- EMAIL / SMTP NOTIFICATIONS & TAX RECEIPTS ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=info@howards4hope.org
SPRING_MAIL_PASSWORD=your_google_app_specific_password

# --- FIREBASE & GOOGLE CLOUD ---
FIREBASE_PROJECT_ID=howards4hope-b06f6
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
SPRING_CLOUD_GCP_ENABLED=false
SPRING_CLOUD_GCP_PUBSUB_ENABLED=false

# --- POSTGRESQL PRODUCTION DATABASE (GCP Cloud SQL / Supabase) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/howards4hope
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password
